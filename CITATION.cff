repository: "https://github.com/datosabiertosAval/ecuadorianCreditRisk"
url: "https://github.com/datosabiertosAval/ecuadorianCreditRisk"

license: "CC-BY-4.0"

keywords:
  - credit risk
  - credit behavior
  - consumer credit
  - microcredit
  - default prediction
